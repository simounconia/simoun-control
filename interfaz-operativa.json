"\n<dialog id=\"screenLock\" hidden aria-labelledby=\"screenLockTitle\"><form class=\"card\" id=\"screenLockForm\">\n<h2 id=\"screenLockTitle\">SIMOUN está bloqueado</h2><p id=\"screenLockHint\"></p>\n<label class=\"field\">Clave<input name=\"password\" type=\"password\" required autocomplete=\"current-password\"></label>\n<label class=\"field\" hidden>Repite tu clave<input name=\"repeat\" type=\"password\" autocomplete=\"new-password\"></label>\n<p role=\"status\" id=\"screenLockMessage\"></p><button class=\"btn\" type=\"submit\">Desbloquear</button>\n<button class=\"btn secondary\" type=\"button\" id=\"screenLockCancel\" hidden>Cancelar</button></form></dialog>\n\n<div class=\"app\">\n<header class=\"topbar\">\n  <h1>SIMOUN · Control Operativo</h1><small>Clientes, servicios, agenda y monitoreos</small>\n  <button type=\"button\" class=\"btn secondary\" onclick=\"SimounSync.signOut()\">Cerrar sesión</button>\n  <nav class=\"nav\" id=\"nav\"></nav>\n  <button class=\"btn secondary\" type=\"button\" id=\"screenLockButton\">🔒 Bloquear</button>\n</header>\n<main class=\"wrap\">\n<section id=\"inicio\" class=\"page active\"></section>\n<section id=\"expedientes\" class=\"page\"></section>\n<section id=\"calendario\" class=\"page\"></section>\n<section id=\"monitoreos\" class=\"page\"></section>\n<section id=\"jornada\" class=\"page\"></section>\n<section id=\"cotizaciones\" class=\"page\"></section>\n<section id=\"remisiones\" class=\"page\"></section>\n<section id=\"recibos\" class=\"page\"></section>\n<section id=\"compras\" class=\"page\"></section><section id=\"caja\" class=\"page\"></section><section id=\"banco\" class=\"page\"></section>\n<div class=\"footer-note\">SIMOUN funciona también sin internet. Si activas la sincronización privada, los expedientes y documentos se comparten entre tus dispositivos autorizados.</div>\n</main>\n<button class=\"fab\" id=\"fab\" title=\"Nuevo expediente\">+</button>\n</div>\n<dialog id=\"clientDlg\"><div class=\"modal-head\"><strong id=\"clientDlgTitle\">Expediente</strong><button class=\"close\" onclick=\"clientDlg.close()\">×</button></div><div class=\"modal-body\" id=\"clientDlgBody\"></div></dialog>\n<dialog id=\"issueDlg\"><div class=\"modal-head\"><strong id=\"issueDlgTitle\">Asunto</strong><button class=\"close\" onclick=\"issueDlg.close()\">×</button></div><div class=\"modal-body\" id=\"issueDlgBody\"></div></dialog>\n<dialog id=\"dayDlg\"><div class=\"modal-head\"><strong id=\"dayDlgTitle\">Agenda del día</strong><button class=\"close\" onclick=\"dayDlg.close()\">×</button></div><div class=\"modal-body\" id=\"dayDlgBody\"></div></dialog>\n<dialog id=\"syncDlg\"><div class=\"modal-head\"><strong>Sincronización privada</strong><button class=\"close\" onclick=\"syncDlg.close()\">×</button></div><div class=\"modal-body\" id=\"syncDlgBody\"></div></dialog>\n<dialog id=\"monitorDlg\"><div class=\"modal-head\"><strong id=\"monitorDlgTitle\">Cliente de monitoreo</strong><button class=\"close\" onclick=\"monitorDlg.close()\">×</button></div><div class=\"modal-body\" id=\"monitorDlgBody\"></div></dialog>\n<dialog id=\"paymentDlg\"><div class=\"modal-head\"><strong id=\"paymentDlgTitle\">Pago de monitoreo</strong><button class=\"close\" onclick=\"paymentDlg.close()\">×</button></div><div class=\"modal-body\" id=\"paymentDlgBody\"></div></dialog>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"
